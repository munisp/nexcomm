            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "thresholds": {
              "mode": "absolute",
