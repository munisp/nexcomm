      {
        "id": 7,
        "title": "Fluvio vs Kafka Throughput Comparison",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 22,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(kafka_producer_record_send_total[1m])",
            "legendFormat": "Kafka msgs/s",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          },
          {
            "expr": "rate(fluvio_producer_records_sent_total[1m])",
