                },
                {
                  "color": "yellow",
                  "value": 500
                },
                {
                  "color": "red",
                  "value": 2000
                }
              ]
            }
          }
        },
        "options": {}
      },
      {
        "id": 4,
        "title": "Idempotency Hit Rate",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 16,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "rate(fundflow_idempotency_hits_total[5m]) / rate(fundflow_operations_total[5m]) * 100",
            "legendFormat": "Hit Rate %",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "percent",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
