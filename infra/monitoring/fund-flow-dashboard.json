{
  "dashboard": {
    "uid": "nexcom-fund-flow",
    "title": "NEXCOM Fund-Flow Observability",
    "description": "Latency, throughput, idempotency hit rate, and saga success rate for all 20 fund-flow scenarios",
    "tags": [
      "nexcom",
      "fund-flow",
      "tigerbeetle",
      "temporal"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 38,
    "panels": [
      {
        "id": 1,
        "title": "Fund-Flow Throughput (ops/s)",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(fundflow_operations_total[1m])",
            "legendFormat": "{{scenario}} ops/s",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 500
                },
                {
                  "color": "red",
                  "value": 2000
                }
              ]
            }
          }
        },
        "options": {}
      },
      {
        "id": 2,
        "title": "Fund-Flow P99 Latency",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(fundflow_duration_ms_bucket[5m]))",
            "legendFormat": "P99 {{scenario}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 500
                },
                {
                  "color": "red",
                  "value": 2000
                }
              ]
            }
          }
        },
        "options": {}
      },
      {
        "id": 3,
        "title": "Fund-Flow P50 Latency",
        "type": "timeseries",
        "gridPos": {
          "x": 12,
          "y": 8,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.50, rate(fundflow_duration_ms_bucket[5m]))",
            "legendFormat": "P50 {{scenario}}",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ms",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
