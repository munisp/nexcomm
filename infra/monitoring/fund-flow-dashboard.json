                {
                  "color": "yellow",
                  "value": 500
                },
                {
                  "color": "red",
                  "value": 2000
                }
              ]
            }
          }
        },
        "options": {}
      },
      {
        "id": 5,
        "title": "Saga Success Rate",
        "type": "stat",
        "gridPos": {
          "x": 6,
          "y": 16,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "rate(temporal_workflow_completed_total{status=\"completed\"}[5m]) / rate(temporal_workflow_started_total[5m]) * 100",
