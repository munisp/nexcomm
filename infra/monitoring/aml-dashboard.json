      {
        "id": 8,
        "title": "OpenSanctions API Latency",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 20,
          "w": 12,
          "h": 8
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.99, rate(opensanctions_request_duration_seconds_bucket[5m])) * 1000",
