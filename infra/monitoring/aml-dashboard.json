{
  "dashboard": {
    "uid": "nexcom-aml",
    "title": "NEXCOM AML & Compliance",
    "description": "Alert rate, false positive rate, OpenSearch indexing lag, sanctions screening latency",
    "tags": [
      "nexcom",
      "aml",
      "compliance",
      "opensearch"
    ],
    "timezone": "browser",
    "refresh": "30s",
    "schemaVersion": 38,
    "panels": [
      {
        "id": 1,
        "title": "AML Alert Rate (all types)",
        "type": "timeseries",
        "gridPos": {
          "x": 0,
          "y": 0,
          "w": 24,
          "h": 8
        },
        "targets": [
          {
            "expr": "rate(aml_alerts_total[1m])",
            "legendFormat": "{{alert_type}} /min",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "ops",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 500
                },
                {
                  "color": "red",
                  "value": 2000
                }
              ]
            }
          }
        },
        "options": {}
      },
      {
        "id": 2,
        "title": "Sanctions Hits (24h)",
        "type": "stat",
        "gridPos": {
          "x": 0,
          "y": 8,
          "w": 6,
          "h": 4
        },
        "targets": [
          {
            "expr": "increase(aml_sanctions_hits_total[24h])",
            "legendFormat": "Sanctions Hits",
            "refId": "A",
            "datasource": {
              "type": "prometheus",
              "uid": "nexcom-prometheus"
            }
          }
        ],
        "fieldConfig": {
          "defaults": {
            "unit": "short",
