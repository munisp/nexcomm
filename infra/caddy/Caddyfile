# ═══════════════════════════════════════════════════════════════════════════════
# NEXCOM Exchange — Caddyfile
# Caddy 2.9+ with xcaddy-built binary including:
#   - github.com/corazawaf/coraza-caddy/v2       (OWASP Coraza WAF)
#   - github.com/mholt/caddy-l4                  (L4 TCP/UDP routing)
#   - github.com/hslatman/caddy-crowdsec-bouncer  (CrowdSec threat intel)
#   - github.com/greenpau/caddy-security          (OIDC/JWT validation)
#
# Build command:
#   xcaddy build \
#     --with github.com/corazawaf/coraza-caddy/v2 \
#     --with github.com/mholt/caddy-l4 \
#     --with github.com/hslatman/caddy-crowdsec-bouncer \
#     --with github.com/greenpau/caddy-security
#
# Environment variables required (injected via Kubernetes Secret):
#   CADDY_ACME_EMAIL          - Let's Encrypt account email
#   CADDY_ACME_DNS_PROVIDER   - DNS provider for wildcard certs (e.g. cloudflare)
#   CADDY_ACME_DNS_TOKEN      - DNS provider API token
#   CROWDSEC_API_KEY          - CrowdSec local API key
#   INTERNAL_NETWORK          - CIDR for internal Kubernetes pod network (e.g. 10.0.0.0/8)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Global options ─────────────────────────────────────────────────────────────
{
    # Admin API — bind to localhost only, not exposed externally
    admin localhost:2019

    # Let's Encrypt ACME configuration
    # DNS-01 challenge enables wildcard certificates (*.nexcomexchange.com)
    acme_ca https://acme-v02.api.letsencrypt.org/directory
    email {$CADDY_ACME_EMAIL}

    # Grace period for certificate renewal before expiry
    cert_lifetime 2160h    # 90 days
    renew_interval 12h

    # OCSP stapling — reduces TLS handshake latency
    ocsp_stapling on

    # Default TLS policy — TLS 1.2 minimum, prefer TLS 1.3
    default_sni nexcomexchange.com

    # Logging — structured JSON for OpenSearch ingestion
    log {
        output file /var/log/caddy/access.log {
            roll_size 100mb
            roll_keep 10
            roll_keep_for 720h
        }
        format json {
            time_format iso8601
        }
        level INFO
    }

    # CrowdSec AppSec — community threat intelligence
    crowdsec {
        api_url http://crowdsec:8080
        api_key {$CROWDSEC_API_KEY}
        ticker_interval 15s
        # Block decisions from CrowdSec community hub
        disable_streaming false
        # AppSec component — blocks application-layer attacks
        appsec_url http://crowdsec:7422
    }

    # Global rate limiting defaults
    servers {
        timeouts {
            read_body   10s
            read_header 5s
            write       30s
            idle        120s
        }
        max_header_size 16kb
    }
}

# ── Coraza WAF snippet — reused across all HTTP sites ─────────────────────────
(coraza_waf) {
    coraza_waf {
        load_owasp_crs
        directives `
            Include @coraza.conf-recommended
            Include @crs-setup.conf.example
            Include @owasp_crs/*.conf
            SecRuleEngine On
            SecRequestBodyAccess On
            SecRequestBodyLimit 52428800
            SecRequestBodyNoFilesLimit 1048576
            SecResponseBodyAccess Off
            SecAuditEngine RelevantOnly
            SecAuditLog /var/log/caddy/modsec_audit.log
            SecAuditLogFormat JSON
            # Tune for financial API — reduce false positives on JSON payloads
            SecRuleUpdateTargetById 942100 "!REQUEST_BODY"
            SecRuleUpdateTargetById 942110 "!REQUEST_BODY"
            # Allow large order payloads (commodity exchange bulk orders)
            SecRequestBodyLimit 10485760
        `
    }
}

# ── Security headers snippet ───────────────────────────────────────────────────
(security_headers) {
    header {
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://js.stripe.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.stripe.com wss://nexcomexchange.com; frame-src https://js.stripe.com; object-src 'none'; base-uri 'self'"
        # Remove server identification headers
        -Server
        -X-Powered-By
    }
}

# ── CORS snippet for API routes ────────────────────────────────────────────────
(api_cors) {
    @cors_preflight method OPTIONS
    handle @cors_preflight {
        header Access-Control-Allow-Origin "https://nexcomexchange.com"
        header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
        header Access-Control-Allow-Headers "Authorization, Content-Type, X-Request-ID"
        header Access-Control-Max-Age "86400"
        respond "" 204
    }
    header Access-Control-Allow-Origin "https://nexcomexchange.com"
    header Access-Control-Allow-Credentials "true"
}

# ═══════════════════════════════════════════════════════════════════════════════
# LAYER 4 — TCP/UDP routing (non-HTTP protocols)
# Handles: USSD (SMPP), Kafka, Redis, PostgreSQL-over-TLS, SSH admin
# ═══════════════════════════════════════════════════════════════════════════════
{
    layer4 {
        # ── Port 2775: SMPP (USSD via Africa's Talking) ──────────────────────
        0.0.0.0:2775 {
            @smpp tls sni ussd.nexcomexchange.com
            route @smpp {
                tls {
                    connection_policy {
                        alpn smpp
                    }
                }
                proxy {
                    upstream ussd-engine:2775
                }
            }
        }

        # ── Port 9092: Kafka (TLS-wrapped, SNI routing) ──────────────────────
        # Internal only — accessible from pod network CIDR
        0.0.0.0:9093 {
            @kafka remote_ip {$INTERNAL_NETWORK}
            route @kafka {
                tls {
                    connection_policy {
                        alpn kafka
                    }
                }
                proxy {
                    upstream kafka-broker-0:9093
                    upstream kafka-broker-1:9093
                    upstream kafka-broker-2:9093
                }
            }
            # Reject non-internal connections
            route {
                proxy {
                    upstream /dev/null
                }
            }
        }

        # ── Port 6380: Redis TLS (internal only) ─────────────────────────────
        0.0.0.0:6380 {
            @redis remote_ip {$INTERNAL_NETWORK}
            route @redis {
                tls
                proxy {
                    upstream redis-master:6379
                }
            }
        }

        # ── Port 5433: PostgreSQL TLS (internal only) ─────────────────────────
        0.0.0.0:5433 {
            @postgres remote_ip {$INTERNAL_NETWORK}
            route @postgres {
                tls {
                    connection_policy {
                        alpn postgresql
                    }
                }
                proxy {
                    upstream nexcom-pg-primary:5432
                }
            }
        }

        # ── Port 2222: SSH admin access (bastion) ─────────────────────────────
        0.0.0.0:2222 {
            @ssh remote_ip {$ADMIN_CIDR}
            route @ssh {
                ssh
                proxy {
                    upstream bastion:22
                }
            }
        }
    }
}

# ═══════════════════════════════════════════════════════════════════════════════
# LAYER 7 — HTTP/HTTPS virtual hosts
# ═══════════════════════════════════════════════════════════════════════════════

# ── Main exchange application ──────────────────────────────────────────────────
nexcomexchange.com, www.nexcomexchange.com {
    tls {
        dns {$CADDY_ACME_DNS_PROVIDER} {$CADDY_ACME_DNS_TOKEN}
        protocols tls1.2 tls1.3
        ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256 TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256 TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        curves x25519 p384 p256
    }

    import coraza_waf
    import security_headers
    import api_cors

    # CrowdSec bouncer — block known bad IPs
    crowdsec

    # Redirect www to apex
    @www host www.nexcomexchange.com
    redir @www https://nexcomexchange.com{uri} permanent

    # Health check endpoint — no WAF, no auth
    @health path /health /api/health
    handle @health {
        respond "OK" 200
    }

    # WebSocket upgrade — live order book, price feed
    @websocket {
        path /api/ws/*
        header Connection *Upgrade*
        header Upgrade websocket
    }
    handle @websocket {
        reverse_proxy apisix:9080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            transport http {
                # Keep WebSocket connections alive
                keepalive 30s
                keepalive_idle_conns 100
            }
        }
    }

    # All other traffic → APISix
    handle {
        reverse_proxy apisix:9080 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-Request-ID {http.request.uuid}
            # Remove internal headers from client requests
            header_up -X-Internal-Token
            header_up -X-Service-Account
            transport http {
                keepalive 30s
                keepalive_idle_conns 320
                response_header_timeout 25s
                dial_timeout 5s
            }
        }
    }

    log {
        output file /var/log/caddy/nexcom-access.log {
            roll_size 500mb
            roll_keep 7
        }
        format json
    }
}

# ── API subdomain (same upstream, separate TLS cert for API clients) ───────────
api.nexcomexchange.com {
    tls {
        dns {$CADDY_ACME_DNS_PROVIDER} {$CADDY_ACME_DNS_TOKEN}
        protocols tls1.2 tls1.3
    }

    import coraza_waf
    import security_headers
    import api_cors

    crowdsec

    # Stricter rate limiting for direct API access
    rate_limit {
        zone api_direct {
            key {remote_host}
            events 200
            window 1m
        }
    }

    reverse_proxy apisix:9080 {
        header_up Host nexcomexchange.com
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Request-ID {http.request.uuid}
    }
}

# ── Keycloak identity provider ─────────────────────────────────────────────────
auth.nexcomexchange.com {
    tls {
        dns {$CADDY_ACME_DNS_PROVIDER} {$CADDY_ACME_DNS_TOKEN}
        protocols tls1.2 tls1.3
    }

    import security_headers

    # Keycloak-specific CSP — allows its own inline scripts
    header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"

    # Rate limit login endpoint — brute force protection at edge
    @login_endpoint path /realms/*/protocol/openid-connect/token /realms/*/login-actions/*
    rate_limit @login_endpoint {
        zone keycloak_login {
            key {remote_host}
            events 10
            window 1m
        }
    }

    reverse_proxy keycloak:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        # Required for Keycloak proxy=edge mode
        header_up X-Forwarded-Host {host}
        health_uri /health/ready
        health_interval 10s
        health_timeout 5s
    }
}

# ── Admin dashboard ────────────────────────────────────────────────────────────
admin.nexcomexchange.com {
    tls {
        dns {$CADDY_ACME_DNS_PROVIDER} {$CADDY_ACME_DNS_TOKEN}
        protocols tls1.3
    }

    import coraza_waf
    import security_headers

    # Admin dashboard — IP allowlist (office + VPN CIDRs)
    @allowed_admin remote_ip {$ADMIN_CIDR} {$VPN_CIDR}
    handle @allowed_admin {
        reverse_proxy apisix:9080 {
            header_up Host nexcomexchange.com
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }

    # Reject all other IPs with 403
    handle {
        respond "Access denied" 403
    }
}

# ── gRPC services (Temporal, internal microservices) ──────────────────────────
grpc.nexcomexchange.com {
    tls {
        dns {$CADDY_ACME_DNS_PROVIDER} {$CADDY_ACME_DNS_TOKEN}
        protocols tls1.3
    }

    # mTLS — require client certificate for all gRPC connections
    tls {
        client_auth {
            mode require_and_verify
            trusted_ca_cert_file /etc/caddy/certs/nexcom-internal-ca.crt
        }
    }

    # Route by gRPC service name (via path prefix)
    @temporal path /temporal.api.workflowservice.v1.WorkflowService/*
    handle @temporal {
        reverse_proxy h2c://temporal-frontend:7233 {
            transport http {
                versions h2c
            }
        }
    }

    @dapr path /dapr.proto.runtime.v1.Dapr/*
    handle @dapr {
        reverse_proxy h2c://dapr-sidecar:50001 {
            transport http {
                versions h2c
            }
        }
    }

    handle {
        respond "Unknown gRPC service" 404
    }
}

# ── Wildcard subdomain catch-all (tenant subdomains) ──────────────────────────
*.nexcomexchange.com {
    tls {
        dns {$CADDY_ACME_DNS_PROVIDER} {$CADDY_ACME_DNS_TOKEN}
    }

    import coraza_waf
    import security_headers

    # Extract subdomain for tenant routing
    @tenant_subdomain not host nexcomexchange.com www.nexcomexchange.com api.nexcomexchange.com auth.nexcomexchange.com admin.nexcomexchange.com grpc.nexcomexchange.com

    handle @tenant_subdomain {
        reverse_proxy apisix:9080 {
            header_up Host {host}
            header_up X-Tenant-Subdomain {labels.1}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}

# ── HTTP → HTTPS redirect (catch-all) ─────────────────────────────────────────
http:// {
    redir https://{host}{uri} permanent
}
