# Copy to an untracked file, populate with local paths, then source before running
# scripts/bootstrap-staging-kubernetes.sh. Do not commit a populated file.
STAGING_NAMESPACE=nexcom-staging
STAGING_SECRET_NAME=nexcom-staging-secrets
STAGING_KUBECONFIG_FILE=/absolute/path/to/staging.kubeconfig
# Optional when the kubeconfig has multiple contexts.
STAGING_CONTEXT=nexcom-staging
STAGING_SECRETS_ENV_FILE=/absolute/path/to/.env.staging.secrets
