# Copy to an untracked file (for example .live-assurance.env) and populate from
# the approved isolated-staging secret manager. Never commit this file.

# Kubernetes identity and namespace
STAGING_CONTEXT=
STAGING_NAMESPACE=nexcom-staging
STAGING_SECRET_NAME=nexcom-staging-secrets
STAGING_KEYCLOAK_NAMESPACE=nexcom-iam
STAGING_KEYCLOAK_DEPLOYMENT=nexcom-keycloak
STAGING_PERMIFY_NAMESPACE=nexcom-infra
STAGING_PERMIFY_DEPLOYMENT=permify
TIGERBEETLE_NAMESPACE=nexcom-infra
TIGERBEETLE_STATEFULSET=tigerbeetle
EXPECTED_PLATFORM_DEPLOYMENTS=29

# Public staging endpoints: HTTPS only, never localhost or example.invalid
STAGING_GATEWAY_URL=
STAGING_KEYCLOAK_URL=
STAGING_KEYCLOAK_ISSUER=
STAGING_PERMIFY_URL=
STAGING_TEMPORAL_HEALTH_URL=
STAGING_DAPR_HEALTH_URL=
KEYCLOAK_REALM=nexcom
STAGING_CA_FILE=

# Image provenance
STAGING_COSIGN_IDENTITY_REGEX=
VERIFY_COSIGN_IMAGES=1

# Permify: a projected local file containing the API token, plus test payloads
# that are stored in a restricted CI workspace. The allow and deny payloads
# must exercise the actual committed tenant/schema/relationship model.
PERMIFY_TENANT_ID=nexcom
PERMIFY_AUTH_TOKEN_FILE=
PERMIFY_ALLOW_CHECK_BODY_FILE=
PERMIFY_DENY_CHECK_BODY_FILE=

# TigerBeetle: a unique nonzero cluster ID and one address per replica in the
# canonical ordinal order. Use 3 only for isolated staging; 6 is required for
# the recommended mission-critical deployment topology.
TIGERBEETLE_CLUSTER_ID=
TIGERBEETLE_EXPECTED_REPLICAS=3
TIGERBEETLE_ADDRESSES=

# Execute only after all non-smoke prerequisites pass. The harness itself
# requires STAGING_TEST_USERNAME and STAGING_TEST_PASSWORD from a protected
# environment/secret source, not this committed template.
EXECUTE_LIVE_SMOKE=0
STAGING_ASSURANCE_REPORT_PATH=test-results/live_staging_prerequisites.jsonl
