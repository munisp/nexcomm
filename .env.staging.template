# Copy to an untracked .env.staging file. Do not commit populated values.
# Empty values are intentional: required credentials and live URLs must come from
# the approved secret manager or CI Environment, never from source defaults.

# Runtime identity
ENVIRONMENT=staging
STAGING_NAMESPACE=nexcom-staging
STAGING_SECRET_NAME=nexcom-staging-secrets
CORS_ORIGINS=
INTERNAL_SECRET=

# Kubernetes operator bootstrap (local operator use only; never upload this
# kubeconfig to CI). Use a separate restricted CI deployer identity.
STAGING_KUBECONFIG_FILE=
STAGING_CONTEXT=
STAGING_SECRETS_ENV_FILE=

# CI/deployment image security
STAGING_REGISTRY=
STAGING_COSIGN_IDENTITY_REGEX=
STAGING_KUBECONFIG_B64=

# PostgreSQL, Redis, Kafka, and application secrets
POSTGRES_PASSWORD=
POSTGRES_URL=
DATABASE_URL=
JWT_SECRET=
REDIS_PASSWORD=
REDIS_URL=
KAFKA_BROKERS=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Keycloak / OIDC runtime configuration
KEYCLOAK_PUBLIC_URL=
KEYCLOAK_URL=
KEYCLOAK_REALM=nexcom
KEYCLOAK_CLIENT_ID=nexcom-gateway
KEYCLOAK_PORTAL_CLIENT_ID=nexcom-portal
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_CLIENT_ID=nexcom-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=

# Authorization, workflows, and sidecars
PERMIFY_ENDPOINT=
PERMIFY_TENANT_ID=t1
TEMPORAL_HOST=
TEMPORAL_NAMESPACE=nexcom
TEMPORAL_TASK_QUEUE=nexcom-main
DAPR_HTTP_PORT=3500
DAPR_GRPC_PORT=50001
TIGERBEETLE_ADDRESSES=
FLUVIO_ENDPOINT=
APISIX_ADMIN_URL=
APISIX_ADMIN_KEY=
APISIX_DASHBOARD_JWT_SECRET=
APISIX_DASHBOARD_ADMIN_USERNAME=
APISIX_DASHBOARD_ADMIN_PASSWORD=

# AI and lakehouse services
LAKEHOUSE_EXECUTOR_URL=
MODEL_REGISTRY_PATH=/models
RISK_TRAINING_DATA_PATH=/models/training/risk-features.npz
OPENAI_API_KEY=
LLM_API_KEY=

# Optional channel, messaging, and external-workflow credentials
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AFRICASTALKING_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
TELEGRAM_BOT_TOKEN=
SENDGRID_API_KEY=
SMTP_PASS=
VAPID_PRIVATE_KEY=

# Secured live smoke-test endpoints. Leave blank until the live staging ingress
# and dependencies are available. A blank STAGING_GATEWAY_URL causes the harness
# to fail at preflight rather than call an invented endpoint.
STAGING_GATEWAY_URL=
STAGING_KEYCLOAK_URL=
STAGING_PERMIFY_URL=
STAGING_TEMPORAL_HEALTH_URL=
STAGING_DAPR_HEALTH_URL=
STAGING_E2E_TIMEOUT_SECONDS=15
STAGING_E2E_RESULT_PATH=test-results/secured_staging_result.json
STAGING_TEST_USERNAME=
STAGING_TEST_PASSWORD=

# Local test-only smoke harness. Never set these in CI or live staging. The
# dedicated launcher supplies loopback values only after LOCAL_SMOKE_TEST_MODE=1.
LOCAL_SMOKE_TEST_MODE=0
LOCAL_SMOKE_BIND_HOST=127.0.0.1
LOCAL_SMOKE_PORT=18090
