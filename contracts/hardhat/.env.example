# NEXCOM Exchange - Smart Contract Deployment Configuration
#
# Copy this file to .env and fill in the values.

# ── RPC Endpoints ────────────────────────────────────────────────────────────
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
ETHEREUM_SEPOLIA_RPC_URL=https://rpc.sepolia.org

# ── Deployer Account ─────────────────────────────────────────────────────────
# Private key of the deployer account (with testnet MATIC for gas)
DEPLOYER_PRIVATE_KEY=0x_your_private_key_here

# ── Verification ─────────────────────────────────────────────────────────────
POLYGONSCAN_API_KEY=your_polygonscan_api_key
