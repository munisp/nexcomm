# ============================================================
# NEXCOM Exchange — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database (REQUIRED) -----------------------------------
DATABASE_URL=postgresql://nexcom:nexcom_secure_2026@127.0.0.1:5432/nexcom

# ---- Auth --------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# ---- Manus OAuth (for hosted deployment on manus.space) ----
# VITE_APP_ID=your-manus-app-id
# OAUTH_SERVER_URL=https://api.manus.im
# VITE_OAUTH_PORTAL_URL=https://manus.im

# ---- Channel Integrations (optional for local dev) ---------
# Africa's Talking (USSD)
AFRICASTALKING_API_KEY=your-at-api-key
AFRICASTALKING_USERNAME=sandbox

# WhatsApp Business (Meta Cloud API)
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Channel Gateway URL (internal service)
CHANNEL_GATEWAY_URL=http://localhost:8080

# ---- Push Notifications (optional) -------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:admin@nexcom.exchange

# ---- Kafka (optional — graceful degradation in dev) --------
KAFKA_BROKERS=localhost:9092

# ---- Redis (optional — graceful degradation in dev) --------
REDIS_URL=redis://localhost:6379

# ---- TigerBeetle (optional — graceful degradation in dev) --
TIGERBEETLE_ADDRESS=localhost:3000

# ---- Email (disabled in dev/test) --------------------------
EMAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# ---- Blockchain (optional) ---------------------------------
FABRIC_PEER_ENDPOINT=localhost:7051
FABRIC_ORDERER_ENDPOINT=localhost:7050
FABRIC_CHANNEL_NAME=nexcom-channel
FABRIC_CHAINCODE_NAME=nexcom-wrc

# ---- Permify RBAC (optional — fail-open in dev) ------------
PERMIFY_HOST=localhost
PERMIFY_PORT=3476
PERMIFY_FAIL_OPEN=true

# ---- OpenSearch (optional) ---------------------------------
OPENSEARCH_URL=http://localhost:9200

# ---- Temporal Workflows (optional) -------------------------
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=nexcom
